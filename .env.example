# Mistral Document AI (Azure AI Foundry)
# Werte aus Azure Portal: ai.azure.com > Meine Ressourcen > Modelle und Endpunkte
MISTRAL_DOC_AI_ENDPOINT="https://<deployment>.<region>.models.ai.azure.com"
MISTRAL_DOC_AI_KEY="<api-key>"

# Anthropic API (fuer LLM Post-Processing mit Claude Haiku)
# Key von https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."

# Docling-Serve API (Layout-Analyse)
# Lokal: docker run -p 5001:5001 quay.io/docling-project/docling-serve-cpu
# Cloud: https://docling-serve-XXXXX-ew.a.run.app
DOCLING_SERVE_URL="http://localhost:5001"

# Gemini API (Layout QA mit Gemini 3.1 Flash Lite)
# Key von https://aistudio.google.com/apikey
GEMINI_API_KEY="AIza..."
