# Mistral Document AI (Azure AI Foundry)
# Werte aus Azure Portal: ai.azure.com > Meine Ressourcen > Modelle und Endpunkte
MISTRAL_DOC_AI_ENDPOINT="https://<deployment>.<region>.models.ai.azure.com"
MISTRAL_DOC_AI_KEY="<api-key>"

# Anthropic API (fuer LLM Post-Processing mit Claude Haiku)
# Key von https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."
