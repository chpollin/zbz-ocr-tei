<?xml version='1.0' encoding='UTF-8'?>
<!--
  TEI-Template: Essay / Artikel
  Für: Einspaltige Texte ohne spezielle Struktur

  Merkmale:
  - div n="1" als Hauptcontainer
  - head mit title
  - Absätze (p) mit lb-Elementen
  - Fußnoten (note) inline
-->
<TEI xmlns="http://www.tei-c.org/ns/1.0" type="naegeli">
  <teiHeader>
    <fileDesc>
      <titleStmt>
        <title type="main">{{DOCUMENT_ID}}</title>
      </titleStmt>
      <publicationStmt>
        <publisher>tranScriptorium</publisher>
      </publicationStmt>
      <sourceDesc>
        <bibl><publisher>TRP document creator: {{CREATOR_EMAIL}}</publisher></bibl>
      </sourceDesc>
    </fileDesc>
  </teiHeader>

  <text>
    <body>
      <div n="1">
        <pb facs="#facs_1" n="{{FIRST_PAGE}}"/>

        <!-- Überschrift -->
        <head>
          <title type="main">{{MAIN_TITLE}}</title>
          <!-- Optional: Untertitel -->
          <!-- <title type="sub">{{SUBTITLE}}</title> -->
        </head>

        <!-- Erster Absatz -->
        <p facs="#facs_1_r_1">
          <lb facs="#facs_1_l_1" n="N001"/>{{PARAGRAPH_1_LINE_1}}
          <lb facs="#facs_1_l_2" n="N002"/>{{PARAGRAPH_1_LINE_2}}
          <!-- Beispiel: Silbentrennung -->
          <lb facs="#facs_1_l_3" n="N003" break="no"/>{{HYPHENATED_WORD_END}}
        </p>

        <!-- Absatz mit Fußnote -->
        <p facs="#facs_1_r_2">
          <lb facs="#facs_1_l_4" n="N001"/>{{TEXT_BEFORE_FOOTNOTE}}
          <note place="foot" n="1" xml:id="fn{{PAGE}}-1">
            {{FOOTNOTE_CONTENT}}
          </note>
          {{TEXT_AFTER_FOOTNOTE}}
        </p>

        <!-- Absatz mit Personenreferenz -->
        <p facs="#facs_1_r_3">
          <lb facs="#facs_1_l_5" n="N001"/><persName ref="GND:{{PERSON_GND}}">{{PERSON_NAME}}</persName> {{REMAINING_TEXT}}
        </p>

        <!-- Absatz mit Werkreferenz (kursiv) -->
        <p facs="#facs_1_r_4">
          <lb facs="#facs_1_l_6" n="N001"/>In seinem Werk <bibl corresp="GND:{{WORK_GND}}"><hi rendition="#i">{{WORK_TITLE}}</hi></bibl> argumentiert er...
        </p>

        <!-- Seitenumbruch -->
        <pb facs="#facs_2" n="{{SECOND_PAGE}}"/>

        <!-- Absatz nach Seitenumbruch -->
        <p facs="#facs_2_r_1">
          <lb facs="#facs_2_l_1" n="N001"/>{{CONTINUED_TEXT}}
        </p>

      </div>
    </body>
  </text>
</TEI>
