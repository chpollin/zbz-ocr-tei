<?xml version='1.0' encoding='UTF-8'?>
<!--
  TEI-Template: Lexikonartikel
  Für: Enzyklopädische Einträge (z.B. über Karl Jaspers)

  Merkmale:
  - div type="entry"
  - head type="lemma" für Stichwort
  - Unterabschnitte (div n="2") für Gliederung
  - div type="bibliography" für Literaturverzeichnis
-->
<TEI xmlns="http://www.tei-c.org/ns/1.0" type="naegeli">
  <teiHeader>
    <fileDesc>
      <titleStmt>
        <title type="main">{{DOCUMENT_ID}}</title>
      </titleStmt>
      <publicationStmt>
        <publisher>tranScriptorium</publisher>
      </publicationStmt>
      <sourceDesc>
        <bibl><publisher>TRP document creator: {{CREATOR_EMAIL}}</publisher></bibl>
      </sourceDesc>
    </fileDesc>
  </teiHeader>

  <text>
    <body>
      <div type="entry">
        <pb facs="#facs_1" n="{{FIRST_PAGE}}"/>

        <!-- Lemma (Stichwort) -->
        <head type="lemma">{{LEMMA}}, {{LIFE_DATES}}</head>

        <!-- Einleitender Überblick -->
        <p facs="#facs_1_r_1">
          <lb facs="#facs_1_l_1" n="N001"/>{{INTRODUCTORY_PARAGRAPH}}
        </p>

        <!-- Abschnitt: Leben -->
        <div n="2">
          <head>{{SECTION_1_TITLE}}</head>
          <p facs="#facs_1_r_2">
            <lb facs="#facs_1_l_2" n="N001"/>{{SECTION_1_CONTENT}}
          </p>
        </div>

        <!-- Abschnitt: Philosophie/Werk -->
        <div n="2">
          <head>{{SECTION_2_TITLE}}</head>
          <p facs="#facs_1_r_3">
            <lb facs="#facs_1_l_3" n="N001"/>{{SECTION_2_CONTENT}}
          </p>
        </div>

        <!-- Bibliografie -->
        <div type="bibliography">
          <head>Literatur</head>
          <listBibl>
            <bibl>{{BIBLIO_ENTRY_1}}</bibl>
            <bibl>{{BIBLIO_ENTRY_2}}</bibl>
            <!-- Hinweis: Einträge in Bibliografien ohne GND-Verknüpfung -->
          </listBibl>
        </div>

      </div>
    </body>
  </text>
</TEI>
