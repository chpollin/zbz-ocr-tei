      }
    },
    {
      "label": "section_header",
      "zbz_tag": "zb_heading",
      "text": "Menke-Glückert",
      "bbox": {
        "x_pct": 7.661,
        "y_pct": 42.917,
        "w_pct": 11.96,
        "h_pct": 1.479
      }
    },
    {
      "label": "text",
      "zbz_tag": "zb_paragraph",
      "text": "Hat sich das nicht inzwischen geändert? Durch das Fernsehen haben wir Vietnam und die Erdbeben in An",
      "bbox": {
        "x_pct": 7.476,
        "y_pct": 45.576,
        "w_pct": 39.056,
        "h_pct": 8.681
      }
    },
    {
      "label": "section_header",
      "zbz_tag": "zb_heading",
