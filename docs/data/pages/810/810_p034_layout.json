    {
      "label": "text",
      "zbz_tag": "zb_paragraph",
      "text": "In welcher befindet sich derjenige; der über viele Probleme in der Welt nachgedacht hat und nun vers",
      "bbox": {
        "x_pct": 7.363,
        "y_pct": 12.826,
        "w_pct": 39.274,
