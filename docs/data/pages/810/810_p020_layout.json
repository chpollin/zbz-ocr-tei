        "h_pct": 1.41
      }
    },
    {
      "label": "text",
      "zbz_tag": "zb_paragraph",
      "text": "Aber Bergson hat sehr mit Recht   gesagt, daß   jede Unordnung eine Form der Ordnung ist.",
      "bbox": {
        "x_pct": 8.629,
        "y_pct": 20.16,
        "w_pct": 39.089,
        "h_pct": 3.708
      }
    },
    {
      "label": "section_header",
      "zbz_tag": "zb_heading",
      "text": "von Weizsäcker",
