    <body><pb facs="#facs_3" n="3" />
        <p facs="#facs_3_r_1">
          <persName ref="#zbz-p.2">Jeanne Hersch</persName>
        </p>
        <p facs="#facs_3_r_2">
          Professorin, lehrt <bibl ref="#zbz-w.1">Philosophie</bibl> an der <orgName ref="#zbz-o.6">Universität Genf</orgName>.<lb facs="#facs_3_l_2_1" n="N001" />Geboren 1912 in <placeName ref="#zbz-l.48">Genf</placeName>.<lb facs="#facs_3_l_2_2" n="N002" />Leitete zweieinhalb Jahre<lb facs="#facs_3_l_2_3" n="N003" />die Abteilung für <bibl ref="#zbz-w.1">Philosophie</bibl> der <orgName ref="#zbz-o.51">UNESCO</orgName> in <placeName ref="#zbz-l.1">Paris</placeName>.<lb facs="#facs_3_l_2_4" n="N004" />Veröffentlichte u. a.:<lb facs="#facs_3_l_2_5" n="N005" /><bibl ref="#zbz-w.91">Die Unfähigkeit, Freiheit zu ertragen</bibl>;<lb facs="#facs_3_l_2_6" n="N006" /><bibl ref="#zbz-w.92">Die Hoffnung, Mensch zu sein</bibl>; <bibl ref="#zbz-w.93">Begegnung</bibl> (Roman).
        </p>
      </body>
  </text>
