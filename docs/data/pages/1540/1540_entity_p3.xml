    <body><pb facs="#facs_3" n="3" />
        <p facs="#facs_3_r_1">
          <persName ref="GND:118815679" source="full-name" cert="medium" resp="#resp-entity-matcher">Jeanne Hersch</persName>
        </p>
        <p facs="#facs_3_r_2">
          Professorin, lehrt Philosophie an der <orgName ref="GND:1010450-1" source="org-variant" cert="medium" resp="#resp-entity-matcher">Universität Genf</orgName>.<lb facs="#facs_3_l_2_1" n="N001" />Geboren 1912 in Genf.<lb facs="#facs_3_l_2_2" n="N002" />Leitete zweieinhalb Jahre<lb facs="#facs_3_l_2_3" n="N003" />die Abteilung für Philosophie der <orgName ref="GND:2023755-8" source="org-token" cert="high" resp="#resp-entity-matcher #resp-entity-adjudication">UNESCO</orgName> in Paris.<lb facs="#facs_3_l_2_4" n="N004" />Veröffentlichte u. a.:<lb facs="#facs_3_l_2_5" n="N005" />Die Unfähigkeit, Freiheit zu ertragen;<lb facs="#facs_3_l_2_6" n="N006" />Die Hoffnung, Mensch zu sein; Begegnung (Roman).
        </p>
      </body>
