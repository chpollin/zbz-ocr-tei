    {
      "label": "text",
      "zbz_tag": "zb_paragraph",
      "text": "A premiere vue, toute determination semble n'etre qu'obstacle",
      "bbox": {
        "x_pct": 11.64,
        "y_pct": 17.592,
        "w_pct": 79.146,
        "h_pct": 2.168
      }
    },
    {
      "label": "text",
      "zbz_tag": "zb_paragraph",
      "text": "Cette profondeur vecue de l'existence n'est pas simplement donnee avec la conscience de l'historicit",
      "bbox": {
        "x_pct": 7.263,
        "y_pct": 25.253,
        "w_pct": 83.835,
        "h_pct": 9.623
      }
    },
    {
      "label": "text",
      "zbz_tag": "zb_paragraph",
      "text": "devant lui-meme de ce qu'il est.",
