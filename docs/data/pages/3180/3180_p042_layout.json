        "h_pct": 3.115
      }
    },
    {
      "label": "text",
      "zbz_tag": "zb_paragraph",
      "text": "Ich würde sagen, daß dies ein analytischer Begriff im kanti schen Sinne ist. Wenn ich sage, habe ich",
      "bbox": {
        "x_pct": 9.4,
        "y_pct": 38.825,
        "w_pct": 84.948,
        "h_pct": 20.647
      }
    },
    {
      "label": "section_header",
