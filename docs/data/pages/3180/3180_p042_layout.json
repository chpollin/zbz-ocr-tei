        "w_pct": 44.483,
        "h_pct": 2.614
      }
    },
    {
      "label": "text",
      "zbz_tag": "zb_paragraph",
      "text": "Ich meine, Sie könnten ja rein theoretisch sagen; daß wir nicht entscheiden können, ob sie oder schl",
      "bbox": {
        "x_pct": 9.595,
        "y_pct": 23.616,
