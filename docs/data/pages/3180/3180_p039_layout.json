        "h_pct": 2.04
      }
    },
    {
      "label": "text",
      "zbz_tag": "zb_paragraph",
      "text": "Ja. Aber ich halte es",
      "bbox": {
        "x_pct": 8.488,
        "y_pct": 12.413,
        "w_pct": 28.832,
        "h_pct": 2.04
      }
    },
    {
      "label": "section_header",
      "zbz_tag": "zb_heading",
      "text": "Jeanne Hersch:",
