        "w_pct": 44.76,
        "h_pct": 2.668
      }
    },
    {
      "label": "text",
      "zbz_tag": "zb_paragraph",
      "text": "Als Beispiel könnte ich mir die Frage vorstellen: Ist die Lüge oder schlecht? Wenn das nicht zu bean",
      "bbox": {
        "x_pct": 7.68,
        "y_pct": 27.204,
        "w_pct": 85.284,
        "h_pct": 11.348
      }
    },
    {
      "label": "section_header",
      "zbz_tag": "zb_heading",
      "text": "Annemarie Pieper:",
