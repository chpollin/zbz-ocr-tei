  "regions": [
    {
      "label": "text",
      "zbz_tag": "zb_paragraph",
      "text": "Jugendfreund,  langjährige Kollege und daher nachher  Feind von Hegel, ist eben ein Exponent dieses ",
      "bbox": {
        "x_pct": 8.683,
        "y_pct": 3.251,
        "w_pct": 85.135,
        "h_pct": 42.441
      }
    },
    {
      "label": "text",
      "zbz_tag": "zb_paragraph",
      "text": "Nun hatten sich mehrere gemeldet; glaube ich",
      "bbox": {
        "x_pct": 8.832,
        "y_pct": 47.723,
        "w_pct": 63.578,
        "h_pct": 2.978
      }
    },
    {
      "label": "section_header",
      "zbz_tag": "zb_heading",
      "text": "Jeanne Hersch:",
      "bbox": {
        "x_pct": 8.728,
        "y_pct": 52.486,
        "w_pct": 22.964,
        "h_pct": 2.04
      }
    },
    {
      "label": "text",
      "zbz_tag": "zb_paragraph",
      "text": "Ich möchte etwas hinzufügen. Ich muß sagen; ich kann auf Ihre Frage, wie man diese doppelte Bezeichn",
      "bbox": {
        "x_pct": 8.488,
        "y_pct": 54.189,
        "w_pct": 85.269,
        "h_pct": 18.789
      }
    },
    {
      "label": "section_header",
      "zbz_tag": "zb_heading",
      "text": "Walther Ch. Zimmerli:",
      "bbox": {
        "x_pct": 9.087,
        "y_pct": 74.563,
        "w_pct": 33.623,
        "h_pct": 2.095
      }
    },
    {
      "label": "text",
      "zbz_tag": "zb_paragraph",
      "text": "Ich habe gesagt; es sei kein Paradox.",
      "bbox": {
        "x_pct": 8.638,
        "y_pct": 76.712,
        "w_pct": 51.287,
        "h_pct": 2.705
      }
    },
    {
      "label": "section_header",
      "zbz_tag": "zb_heading",
      "text": "Jeanne Hersch:",
      "bbox": {
        "x_pct": 8.728,
        "y_pct": 81.33,
        "w_pct": 23.114,
        "h_pct": 2.095
      }
    },
    {
      "label": "text",
      "zbz_tag": "zb_paragraph",
      "text": "Es ist ein Paradox, ja,",
      "bbox": {
        "x_pct": 8.728,
        "y_pct": 83.333,
        "w_pct": 30.749,
        "h_pct": 2.577
      }
    },
    {
      "label": "section_header",
      "zbz_tag": "zb_heading",
      "text": "Walther Ch. Zimmerli:",
      "bbox": {
        "x_pct": 9.237,
        "y_pct": 87.914,
        "w_pct": 33.623,
        "h_pct": 2.095
      }
    },
    {
      "label": "text",
      "zbz_tag": "zb_paragraph",
      "text": "Ich halte es nicht für",
      "bbox": {
        "x_pct": 8.728,
        "y_pct": 90.228,
        "w_pct": 29.491,
        "h_pct": 1.94
