    <body><pb facs="#facs_9" n="[7]" />
        <div type="text">
<head>
          <lb facs="#facs_9_r_1_1" n="N001" />A MON MAÎTRE
          <lb facs="#facs_9_r_1_2" n="N002" /><persName ref="GND:118557106" source="caps-full-name" resp="#resp-entity-matcher">KARL JASPERS</persName>
        </head>
        <p facs="#facs_9_r_2">
          <lb facs="#facs_9_r_2_1" n="N001" />qui me fit connaître la pensée existentialiste,
          <lb facs="#facs_9_r_2_2" n="N002" />ainsi nommée parce qu’elle appelle
          <lb facs="#facs_9_r_2_3" n="N003" />l’existence à chercher la transcendance
          <lb facs="#facs_9_r_2_4" n="N004" />aux limites du savoir.
        </p>
      </div>
