    {
      "label": "text",
      "zbz_tag": "zb_paragraph",
      "text": "Quand exerce pour obtenir une chose à laquelle on n'a pas droit?",
      "bbox": {
        "x_pct": 53.383,
        "y_pct": 29.876,
        "w_pct": 32.171,
        "h_pct": 4.103
      }
    },
    {
      "label": "text",
      "zbz_tag": "zb_paragraph",
      "text": "Peut-on également parler de chantagc lorsque Fon tente d'obtenir une chose à laquelle on a droit? au",
      "bbox": {
        "x_pct": 53.206,
        "y_pct": 34.809,
        "w_pct": 39.641,
        "h_pct": 8.437
      }
    },
    {
      "label": "section_header",
      "zbz_tag": "zb_heading",
