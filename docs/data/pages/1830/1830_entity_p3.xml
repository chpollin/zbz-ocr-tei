    <body><pb facs="#facs_3" n="3" />
        <p facs="#facs_3_r_1">
          JEANNE HERSCH
        </p>
        <p facs="#facs_3_r_2">
          born 13th July 1910 in Geneva (Switzerland)
        </p>
        <p facs="#facs_3_r_3">
          studied at<lb facs="#facs_3_l_3_1" n="N001" />- <orgName ref="GND:1010450-1">University of Geneva</orgName><lb facs="#facs_3_l_3_2" n="N002" />- University of Paris<lb facs="#facs_3_l_3_3" n="N003" />- University of Heidelberg
        </p>
        <p facs="#facs_3_r_4">
          degrees received<lb facs="#facs_3_l_4_1" n="N001" />- Licenciée ès Lettres (Geneva)<lb facs="#facs_3_l_4_2" n="N002" />- Doctorat ès Lettres (Geneva)
        </p>
        <p facs="#facs_3_r_5">
          positions held<lb facs="#facs_3_l_5_1" n="N001" />- Ecole Internationale de Genève<lb facs="#facs_3_l_5_2" n="N002" />- Professor of Philosophy, <orgName ref="GND:1010450-1">University of Geneva</orgName><lb facs="#facs_3_l_5_3" n="N003" />- Director, Division of Philosophy, <orgName ref="GND:2023755-8">UNESCO</orgName><lb facs="#facs_3_l_5_4" n="N004" />- Visiting Professor, various universities in the USA
        </p>
        <p facs="#facs_3_r_6">
          present position<lb facs="#facs_3_l_6_1" n="N001" />- Professor emeritus, <orgName ref="GND:1010450-1">University of Geneva</orgName>
        </p>
        <p facs="#facs_3_r_7">
          present address<lb facs="#facs_3_l_7_1" n="N001" />(private)<lb facs="#facs_3_l_7_2" n="N002" />- 14 avenue Pierre Odier<lb facs="#facs_3_l_7_3" n="N003" />- 1208 Genève<lb facs="#facs_3_l_7_4" n="N004" />- Suisse
        </p>
        <p facs="#facs_3_r_8">
          member of<lb facs="#facs_3_l_8_1" n="N001" />- Société Suisse de Philosophie<lb facs="#facs_3_l_8_2" n="N002" />- Pen-Club<lb facs="#facs_3_l_8_3" n="N003" />- Société Suisse des Ecrivains
        </p>
        <p facs="#facs_3_r_9">
          office held in academic life<lb facs="#facs_3_l_9_1" n="N001" />- Présidente de la Fondation <persName ref="GND:118557106">Karl Jaspers</persName>, Dâle
        </p>
        <p facs="#facs_3_r_10">
          office held in international life<lb facs="#facs_3_l_10_1" n="N001" />- Member, Executive Council, <orgName ref="GND:2023755-8">UNESCO</orgName>
        </p>
        <p facs="#facs_3_r_11">
          honorary degree<lb facs="#facs_3_l_11_1" n="N001" />- Dr. theol. h.c., <orgName ref="GND:36146-X">University of Basle</orgName>
        </p>
        <p facs="#facs_3_r_12">
          honour received<lb facs="#facs_3_l_12_1" n="N001" />- Montaigne Prize 1979, Hamburg
        </p>
      </body>
